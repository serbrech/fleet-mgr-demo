{
  "displayName": "Fleet Auto-Join",
  "description": "This policy enables you to automatically join AKS clusters to a predefined fleet.",
  "policyType": "Custom",
  "metadata": {
    "version": "1.0.0",
    "category": "Fleet"
  },
  "parameters": {
    "fleet-subscription-id": {
      "type": "string",
      "metadata": {
        "description": "The Fleet Manager subscription ID.",
        "displayName": "Fleet Subscription ID"
      }
    },
    "fleet-resource-group": {
      "type": "string",
      "metadata": {
        "description": "The Fleet Manager resource group.",
        "displayName": "Fleet Resource Group"
      }
    },
    "fleet-name": {
      "type": "string",
      "metadata": {
        "description": "The Fleet Manager name that the clusters will join.",
        "displayName": "Fleet Name"
      }
    },
    "fleet-group-tag": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The resource tag on the AKS cluster. It will be looked up for specifying which fleet group to join.",
        "displayName": "Group Tag"
      }
    }
  },
  "mode": "All",
  "policyRule": {
    "if": {
      "allOf": [
        {
          "field": "type",
          "equals": "Microsoft.ContainerService/managedClusters"
        },
        {
          "field": "identity.type",
          "in": [
            "UserAssigned",
            "SystemAssigned"
          ]
        },
        {
          "field": "Microsoft.ContainerService/managedClusters/nodeResourceGroup",
          "notLike": "MC_FL_*"
        },
        {
          "field": "name",
          "notEquals": "hub"
        },
        {
          "field": "tags['IgnoreFleetDINEPolicy']",
          "notEquals": "true"
        }
      ]
    },
    "then": {
      "effect": "deployIfNotExists",
      "details": {
        "type": "Microsoft.ContainerService/fleetMemberships",
        "name": "default",
        "existenceCondition": {
          "allOf": [
            {
              "field": "id",
              "exists": "true"
            }
          ]
        },
        "deployment": {
          "properties": {
            "mode": "incremental",
            "template": {
              "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
              "contentVersion": "1.0.0.0",
              "parameters": {
                "member-name": {
                  "type": "string"
                },
                "fleet-name": {
                  "type": "string"
                },
                "fleet-resource-group": {
                  "type": "string"
                },
                "fleet-subscription-id": {
                  "type": "string"
                },
                "cluster-resource-id": {
                  "type": "string"
                },
                "fleet-group": {
                  "type": "string",
                  "defaultValue": ""
                }
              },
              "resources": [
                {
                  "name": "[concat('join-with-fleet-', parameters('fleet-name'))]",
                  "type": "Microsoft.Resources/deployments",
                  "apiVersion": "2022-09-01",
                  "subscriptionId": "[parameters('fleet-subscription-id')]",
                  "resourceGroup": "[parameters('fleet-resource-group')]",
                  "properties": {
                    "mode": "Incremental",
                    "template": {
                      "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                      "contentVersion": "1.0.0.0",
                      "resources": [
                        {
                          "type": "Microsoft.ContainerService/fleets/members",
                          "apiVersion": "2024-05-02-preview",
                          "name": "[concat(parameters('fleet-name'), '/', parameters('member-name'))]",
                          "properties": {
                            "clusterResourceId": "[parameters('cluster-resource-id')]",
                            "group": "[toLower(parameters('fleet-group'))]"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "parameters": {
              "member-name": {
                "value": "[concat(field('name'), '-', uniqueString(field('id')))]"
              },
              "fleet-name": {
                "value": "[parameters('fleet-name')]"
              },
              "fleet-resource-group": {
                "value": "[parameters('fleet-resource-group')]"
              },
              "fleet-subscription-id": {
                "value": "[parameters('fleet-subscription-id')]"
              },
              "cluster-resource-id": {
                "value": "[field('id')]"
              },
              "fleet-group": {
                "value": "[field(concat('tags[', parameters('fleet-group-tag'), ']'))]"
              }
            }
          }
        }
      }
    }
  }
}
